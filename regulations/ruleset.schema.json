{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-credit-evidence.local/schemas/jurisdiction-ruleset.json",
  "title": "OpenCredit Evidence jurisdiction ruleset",
  "type": "object",
  "required": ["ruleset_id", "version", "jurisdiction", "last_verified", "rules"],
  "properties": {
    "ruleset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "last_verified": {"type": "string", "format": "date"},
    "scope": {"type": "object"},
    "eu_baseline": {"type": "array", "items": {"type": "string"}},
    "platform_control_mapping": {"type": "object"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "citation",
          "category",
          "enforcement",
          "obligation_owner",
          "applicability",
          "requirement_summary",
          "evidence_requirements",
          "finos_controls",
          "official_sources"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^IT-[A-Z0-9-]+$"},
          "title": {"type": "string"},
          "citation": {"type": "string"},
          "category": {"type": "string"},
          "enforcement": {"enum": ["required", "transition", "reference"]},
          "obligation_owner": {"enum": ["lender", "platform", "open_credit_evidence"]},
          "applicability": {"type": "object"},
          "requirement_summary": {"type": "string"},
          "evidence_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "description"],
              "properties": {
                "key": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "finos_controls": {
            "type": "array",
            "items": {"enum": ["mi-1", "mi-4", "mi-5", "mi-11"]}
          },
          "official_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["publisher", "url"],
              "properties": {
                "publisher": {"type": "string"},
                "url": {"type": "string", "format": "uri"}
              }
            }
          }
        }
      }
    }
  }
}
