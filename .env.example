# Copy to .env (gitignored). With the three roles below pointed at the team's
# node, a local run needs no key at all. The key is only used for a role left on
# NVIDIA Build (comment its two lines out to do that) and by the Hugging Face
# Space, which cannot reach the node. Generate one at build.nvidia.com -> Manage
# API Keys; never commit the real value.
NVIDIA_API_KEY=nvapi-...

# Where the three roles run. The team's servers are one SLURM job on the Codefest
# cluster (scripts/cluster/servers.sbatch); the job publishes its node and ports
# to /data/team08/runs/servers.env — copy that file's six lines here. VPN
# required (docs/cluster.md). Comment a role's lines out to use NVIDIA Build.
EVIDENCE_ASSISTANT_BASE_URL=http://10.130.232.22:8200/v1
EVIDENCE_ASSISTANT_MODEL=nvidia/nemotron-3.5-lightning

# The judge: Nemotron Nano 9B v2 served by vLLM on the same node
# (scripts/cluster/serve_nano.sh). Un-tuned today; the fine-tuned adapter
# replaces it behind the same two lines. Comment out to judge with Nemotron
# 3 Ultra on NVIDIA Build instead.
EVIDENCE_JUDGE_BASE_URL=http://10.130.232.22:8201/v1
EVIDENCE_JUDGE_MODEL=nano-judge

# The embedder (corpus build and the judge's retrieval query): Nemotron 3 Embed
# 1B served by vLLM on the node (scripts/cluster/serve_embed.sh).
EVIDENCE_EMBED_BASE_URL=http://10.130.232.22:8202/v1
EVIDENCE_EMBED_MODEL=nemotron-3-embed-1b
