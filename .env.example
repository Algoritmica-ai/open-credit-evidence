# OpenCredit Evidence Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# NVIDIA Build (OpenAI-compatible). Either key name works; NVIDIA_API_KEY wins if both set.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your-api-key-here
# NEMOTRON_API_KEY=your-api-key-here

# Whole-file summarizer (Week 1). Embeddings / vector search come later.
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Thinking/reasoning tokens off by default (cleaner summaries for omission checks).
# NEMOTRON_ENABLE_THINKING=false

# Force stub summaries even if a key is set (pytest sets this automatically).
# OCE_STUB_NEMOTRON=1

# Evidence verification
# Set to "strict" for production, "permissive" for development
EVIDENCE_VERIFICATION_MODE=strict

# Logging
LOG_LEVEL=INFO

# Axis / Curiosity are optional GPU/Jupyter compute only.
# They are not an application host. Do not set portal deploy URLs here.
