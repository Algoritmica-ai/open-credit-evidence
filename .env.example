# Copy to .env (gitignored). Generate the key at https://build.nvidia.com -> Manage API Keys.
# Never commit the real value. The key is needed for anything that still runs on
# NVIDIA Build (the judge and the embedder by default).
NVIDIA_API_KEY=nvapi-...

# Where the assistant under test runs. This points at the Nemotron 3.5 Lightning
# NIM on the team's Codefest node (VPN required, see docs/cluster.md). Comment
# both lines out to run the assistant on NVIDIA Build instead.
EVIDENCE_ASSISTANT_BASE_URL=http://10.130.232.20:8000/v1
EVIDENCE_ASSISTANT_MODEL=nvidia/nemotron-3.5-lightning

# The judge and the embedder can be moved the same way:
# EVIDENCE_JUDGE_BASE_URL=http://10.130.232.20:8001/v1
# EVIDENCE_JUDGE_MODEL=nano-judge
# EVIDENCE_EMBED_BASE_URL=...
