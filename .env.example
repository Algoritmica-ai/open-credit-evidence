# OpenCredit Evidence Configuration
# Copy this file to .env and fill in your values

# NVIDIA Nemotron API Configuration
# Base URL for Nemotron API (NVIDIA Build hosted endpoint)
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=your-api-key-here

# Model configuration
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# Evidence verification
# Set to "strict" for production, "permissive" for development
EVIDENCE_VERIFICATION_MODE=strict

# Logging
LOG_LEVEL=INFO

# Axis / Curiosity are optional GPU/Jupyter compute only.
# They are not an application host. Do not set portal deploy URLs here.
